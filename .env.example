# 실제 값은 .env 파일에만 적고, .env는 절대 커밋하지 않습니다.

# 에이전트 호출 방식: claude_cli(기본, claude -p) | anthropic_api
EVBLOG_AGENT_BACKEND=claude_cli

# anthropic_api 방식으로 전환할 때만 필요
ANTHROPIC_API_KEY=

# (선택) 사용 모델
EVBLOG_MODEL=

# (선택) 이후 확장용 알림 채널 - 1차에서는 사용하지 않음
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
